# Copy to .env.local and fill in. Get a key at https://platform.openai.com
OPENAI_API_KEY=
VISION_MODEL=gpt-5.6-luna
# Optional: identify this app to Open Food Facts. Their preferred format is
# AppName/Version (URL or contact email).
OPEN_FOOD_FACTS_USER_AGENT=

# Supabase (dashboard → Project Settings). Logins use Supabase Auth; the tables
# and their per-user RLS policies are in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (never NEXT_PUBLIC_): skips RLS, for the admin pages and for giving
# back an analysis when the AI call fails. Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=
