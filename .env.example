# Copy to .env.local and fill in. Get a key at https://platform.openai.com
OPENAI_API_KEY=
VISION_MODEL=gpt-5.6-luna
# Optional: when set, the whole site requires this password (Basic Auth).
# Leave empty locally; set it in Vercel so the deployed site is private.
SITE_PASSWORD=

# Supabase (dashboard → Project Settings). The meal log lives in the
# public.meals table — schema in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Preferred over the publishable key when set (server-only, bypasses RLS).
SUPABASE_SECRET_KEY=
